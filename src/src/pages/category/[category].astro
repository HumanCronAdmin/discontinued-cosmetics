---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const all = await getCollection('products', ({ data }) => !data.draft);
  const catSet = new Set(all.map((p) => p.data.category));
  return [...catSet].map((category) => ({
    params: { category },
    props: {
      category,
      products: all.filter((p) => p.data.category === category),
    },
  }));
}

const { category, products } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout
  title={`Discontinued ${category} — Holy Grail Archive`}
  description={`All discontinued ${category} products tracked: launch year, discontinued year, resale price history, and dupe / successor recommendations.`}
>
  <div class="container">
    <p class="breadcrumb"><a href={baseUrl}>Home</a> › <a href={`${baseUrl}/categories`}>Categories</a> › {category}</p>
    <h1>Discontinued {category}</h1>
    <ul class="product-list">
      {products.map((p) => {
        const brandSlug = p.data.brand.toLowerCase().replace(/\s+/g, '-');
        return (
          <li>
            <a href={`${baseUrl}/${brandSlug}/${p.data.slug}`}>
              <strong>{p.data.brand} {p.data.product_name}</strong>
              <span class="meta">Discontinued {p.data.discontinued_year ?? '—'}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</BaseLayout>

<style>
  .breadcrumb { color: var(--muted); font-size: 0.85rem; margin: 1rem 0; }
  .breadcrumb a { color: var(--muted); }
  h1 { margin: 0.5rem 0 1.5rem; text-transform: capitalize; }
  .product-list { list-style: none; padding: 0; display: grid; gap: 0.5rem; }
  .product-list a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.75rem 1rem;
  }
  .product-list a:hover { border-color: var(--accent); }
  .meta { color: var(--muted); font-size: 0.85rem; }
</style>
