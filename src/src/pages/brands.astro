---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const all = await getCollection('products', ({ data }) => !data.draft);
const baseUrl = import.meta.env.BASE_URL;

const brandMap = new Map<string, number>();
for (const p of all) {
  brandMap.set(p.data.brand, (brandMap.get(p.data.brand) ?? 0) + 1);
}
const brands = [...brandMap.entries()].sort((a, b) => a[0].localeCompare(b[0]));
---

<BaseLayout
  title="All Brands — Holy Grail Archive"
  description="Browse all cosmetics brands tracked in the discontinued cosmetics database."
>
  <div class="container">
    <h1>All Brands</h1>
    <ul class="brand-list">
      {brands.map(([brand, count]) => (
        <li>
          <a href={`${baseUrl}/brand/${brand.toLowerCase().replace(/\s+/g, '-')}`}>
            {brand} <span class="count">({count})</span>
          </a>
        </li>
      ))}
    </ul>
    {brands.length === 0 && <p class="muted">No brands published yet.</p>}
  </div>
</BaseLayout>

<style>
  h1 { margin: 1rem 0 1.5rem; }
  .brand-list {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 0.5rem;
  }
  .brand-list a {
    display: block;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.6rem 0.85rem;
  }
  .brand-list a:hover { border-color: var(--accent); }
  .count { color: var(--muted); font-size: 0.85rem; }
  .muted { color: var(--muted); }
</style>
